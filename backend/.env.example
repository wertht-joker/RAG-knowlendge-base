# 复制本文件为 .env，并填入真实配置

# ===== DeepSeek 对话模型 =====
DEEPSEEK_API_KEY=sk-你的deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=kb_documents

# ===== 本地 Embedding 模型 =====
# 中文向量模型，首次运行会自动从 HuggingFace 下载（约 400MB）
# 国内可设环境变量 HF_ENDPOINT=https://hf-mirror.com 加速
EMBEDDING_MODEL=BAAI/bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu

# ===== 检索参数 =====
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50
